---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see the props it renders.
import type { Dictionary } from "../lib/language/dictionary"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
---

{/* The three plain facts above the install window (site#69): the limits a visitor meets after the step, read before it. */}
<dl data-facts class="hero-facts mt-10 w-full max-w-3xl border-t border-border pt-5 text-left">
	{
		dictionary.factLabels.map((label, index) => (
			<div class="hero-fact" data-fact>
				<dt class="text-muted-foreground">{label}</dt>
				<dd class="text-foreground">{dictionary.factTexts[index]}</dd>
			</div>
		))
	}
</dl>
